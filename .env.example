# ─────────────────────────────────────────────────────────────────────────────
# Signal Engine → Execution Engine → MetaTrader 5
# ─────────────────────────────────────────────────────────────────────────────

SIGNAL_ENGINE_WS_URL=ws://localhost:8765
# XAUUSD,US500,US30,US100,BTCUSD
SIGNAL_ENGINE_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD

# ─────────────────────────────────────────────────────────────────────────────
# MT5 terminal credentials
# ─────────────────────────────────────────────────────────────────────────────

MT5_LOGIN=106020372
MT5_PASSWORD=';j5;FV}2'
MT5_SERVER=FBS-Demo
MT5_MAGIC=8858
MT5_SLIPPAGE=10
MT5_COMMENT = "xcom-bobisquote"
MT5_EXEC_PATH=c:\\Program Files\FBS MetaTrader 5\terminal64.exe

# ─────────────────────────────────────────────────────────────────────────────
# TIMEZONE
# ─────────────────────────────────────────────────────────────────────────────

ENGINE_TIMEZONE=UTC

# ─────────────────────────────────────────────────────────────────────────────
# RISK MODE
# ─────────────────────────────────────────────────────────────────────────────
# RISK_MODE=percentage   → risk RISK_PERCENT_PER_TRADE % of account balance
# RISK_MODE=fixed        → risk exactly RISK_FIXED_AMOUNT per trade (e.g. $100)

RISK_MODE=percentage
RISK_PERCENT_PER_TRADE=5.0
RISK_FIXED_AMOUNT=100.0

# ─────────────────────────────────────────────────────────────────────────────
# RISK LIMITS  (apply regardless of RISK_MODE)
# ─────────────────────────────────────────────────────────────────────────────

MAX_OPEN_TRADES=10
MAX_DAILY_LOSS_PERCENT=100.0

# MAX_OPEN_TRADES and MAX_DAILY_LOSS_PERCENT work together automatically:
#   • Hard stop fires at 95% of MAX_DAILY_LOSS_PERCENT (= 4.75% with the
#     default of 5%), so open positions can never push you past the full limit.
#   • Pre-trade projection: if current_loss + per_trade_risk > 95% threshold,
#     the trade is rejected before it is sent to the broker.
#     With 5 trades × 1% risk and a 5% budget, the engine stops accepting new
#     trades once 3.75% has been lost (next 1% would exceed 4.75%).
#   → You never need to manually align these two variables — the engine does it.

MAX_EXPOSURE_PER_SYMBOL=2
MIN_RR_RATIO=1
MAX_LOT_SIZE=100.0
MIN_LOT_SIZE=0.01
SL_RATIO_THRESHOLD=0.25

# ─────────────────────────────────────────────────────────────────────────────
# CIRCUIT-BREAKER GUARD
# ─────────────────────────────────────────────────────────────────────────────
# Single knob — all three guards are derived from MAX_CONSECUTIVE_LOSSES (N):
#
#   Guard 1 — streak:   pause N×1.2 hours after N losses in a row
#   Guard 2 — daily:    block trading for the rest of the day after N losses
#   Guard 3 — window:   cooldown until window expires after N losses in N hours
#
# Example  N=10:
#   pause = 12.0 h  |  max_daily = 10  |  window_count = 10  |  window = 10 h

MAX_CONSECUTIVE_LOSSES=10

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION
# ─────────────────────────────────────────────────────────────────────────────

# R-multiple at which the partial close fires (overrides signal.tp1).
# e.g. 1.5 → partial at entry + 1.5 × stop_distance.  After partial + BE
# the remaining position runs to TP2 completely risk-free.
# Must be ≤ MIN_RR_RATIO so TP1 never sits beyond TP2.
TP1_RR_MULTIPLE=1.5
# Percentage of entry_lots to close when TP1 is reached (0 = disabled).
TP1_PERCENTAGE=50
# Move SL to entry after a successful TP1 partial close (no-op if TP1_PERCENTAGE=0).
MOVE_SL_TO_BE_ON_TP1=true
NO_HEDGING=true

# ─────────────────────────────────────────────────────────────────────────────
# LIVE TRADING PROTECTIONS
# ─────────────────────────────────────────────────────────────────────────────
# [1] Max slippage accepted AFTER a fill (pips). Exceeded → position closed.
#     Set higher for volatile pairs (XAUUSD, BTC/crypto: 5-10).
MAX_ENTRY_SLIPPAGE_PCT_OF_STOP=0.20
CLOSE_ON_SLIPPAGE_EXCEED=false        
# true = emergency-close position; false = warn and accept fill  
# Reject fill if adverse slippage > 20% of stop distance

# [2] Spread surcharge for lot sizing.
#     1.0 = full spread added to SL distance (live / standard accounts)
#     0.0 = disabled (demo or tight ECN accounts)
SPREAD_RISK_MULTIPLIER=1.0

# [3] Retry count on requote / rejection  (0 = no retries)
ORDER_RETRY_COUNT=2
ORDER_RETRY_DELAY_SEC=0.5

# ─────────────────────────────────────────────────────────────────────────────
# POSITION MANAGER
# ─────────────────────────────────────────────────────────────────────────────

POSITION_POLL_INTERVAL_SEC=1.1

# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR

LOG_LEVEL=INFO
STORAGE_PATH=./data
