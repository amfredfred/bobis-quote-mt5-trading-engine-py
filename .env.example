# ─────────────────────────────────────────────────────────────────────────────
# Signal Engine → Execution Engine → MetaTrader 5
# ─────────────────────────────────────────────────────────────────────────────

SIGNAL_ENGINE_WS_URL=ws://localhost:8765
SIGNAL_ENGINE_WS_SECRET_KEY=RANDOM_SECRET_KEY_FOR_AUTHENTICATION
SIGNAL_ENGINE_SYMBOLS=XAUUSD,US500,US30,US100,BTCUSD,EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD

# ─────────────────────────────────────────────────────────────────────────────
# MT5 terminal credentials
# ─────────────────────────────────────────────────────────────────────────────

MT5_LOGIN=106020372
MT5_PASSWORD=';j5;FV}2'
MT5_SERVER=FBS-Demo
MT5_MAGIC=8858
MT5_SLIPPAGE=10
MT5_COMMENT = "xcom-bobisquote"
MT5_EXEC_PATH=c:\\Program Files\FBS MetaTrader 5\terminal64.exe

# ─────────────────────────────────────────────────────────────────────────────
# TIMEZONE
# ─────────────────────────────────────────────────────────────────────────────

ENGINE_TIMEZONE=UTC


# ─────────────────────────────────────────────────────────────────────────────
# RISK LIMITS  (apply regardless of RISK_MODE)
# ─────────────────────────────────────────────────────────────────────────────
MAX_LOSING_STREAK=4
MAX_DAILY_LOSS_PERCENT=3.0
MAX_EXPOSURE_PER_SYMBOL=2
MIN_RR_RATIO=1
MAX_LOT_SIZE=100.0
MIN_LOT_SIZE=0.01
SL_RATIO_THRESHOLD=0.34

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION
# ─────────────────────────────────────────────────────────────────────────────

# R-multiple at which the partial close fires (overrides signal.tp1).
# e.g. 1.5 → partial at entry + 1.5 × stop_distance.  After partial + BE
# the remaining position runs to TP2 completely risk-free.
# Must be ≤ MIN_RR_RATIO so TP1 never sits beyond TP2.
TP1_RR_MULTIPLE=1
# Percentage of entry_lots to close when TP1 is reached (0 = disabled).
TP1_PERCENTAGE=50
# Move SL to entry after a successful TP1 partial close (no-op if TP1_PERCENTAGE=0).
MOVE_SL_TO_BE_ON_TP1=true
NO_HEDGING=true

# ─────────────────────────────────────────────────────────────────────────────
# LIVE TRADING PROTECTIONS
# ─────────────────────────────────────────────────────────────────────────────
# [1] Max slippage accepted AFTER a fill (pips). Exceeded → position closed.
#     Set higher for volatile pairs (XAUUSD, BTC/crypto: 5-10).
MAX_ENTRY_SLIPPAGE_PCT_OF_STOP=0.20
CLOSE_ON_SLIPPAGE_EXCEED=false        
# true = emergency-close position; false = warn and accept fill  
# Reject fill if adverse slippage > 20% of stop distance
MAX_EQUITY_DRAWDOWN_PERCENT=3
ROLLING_WINDOW_SIZE=2
ROLLING_DRAWDOWN_PCT=2

# [1b] Level adjustment on slippage fill.
#      false (default): SL/TP stay at the signal's analysis-derived prices — slippage
#      is absorbed into a slightly tighter/wider stop distance, which is correct when
#      your levels are set at specific structure prices.
#      true: all levels shift by the fill delta so R:R is preserved relative to the
#      actual fill price — use only if your levels are purely distance-based.
USE_SLIPPAGE_ADJUSTED_LEVELS=false

# [2] Spread surcharge for lot sizing.
#     1.0 = full spread added to SL distance (live / standard accounts)
#     0.0 = disabled (demo or tight ECN accounts)
SPREAD_RISK_MULTIPLIER=1.0

# [3] Retry count on requote / rejection  (0 = no retries)
ORDER_RETRY_COUNT=2
ORDER_RETRY_DELAY_SEC=0.5

# ─────────────────────────────────────────────────────────────────────────────
# POSITION MANAGER
# ─────────────────────────────────────────────────────────────────────────────

POSITION_POLL_INTERVAL_SEC=0.6

# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR

LOG_LEVEL=INFO
STORAGE_PATH=./data