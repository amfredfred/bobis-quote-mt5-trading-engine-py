# Secrets only — copy to .env (git-ignored).
# All other config lives in config.yaml.

MT5_PASSWORD=your_mt5_password
TRADERELAY_ACTIVATION_KEY=replace_with_your_activation_key

# Optional: HMAC-SHA256 secret for inbound signal signature verification (2.8)
# If set, signals without a valid signature are dropped silently.
# Must match the secret used by the Signal Engine when signing signals.
SIGNAL_HMAC_SECRET=
