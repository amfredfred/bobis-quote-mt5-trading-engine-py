# Signal Engine → Execution Engine → MetaTrader 5
SIGNAL_ENGINE_WS_URL=ws://localhost:8765
SIGNAL_ENGINE_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/CAD,NZD/USD,AUD/USD,EUR/GBP,EUR/JPY,AUD/JPY,XAU/USD,XAG/USD,US100,JP225,US500,UK100,BTC/USD,ETH/USD,SOL/USD

# MT5 terminal credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Live
MT5_MAGIC=20240101
MT5_SLIPPAGE=10
MT5_COMMENT=signal-engine

# ─────────────────────────────────────────
# TIMEZONE
# ─────────────────────────────────────────
ENGINE_TIMEZONE=Africa/Lagos

# ── Risk mode ──────────────────────────────────────────────────────────────
# RISK_MODE=percentage   →  risk RISK_PERCENT_PER_TRADE % of account balance
# RISK_MODE=fixed        →  risk exactly RISK_FIXED_AMOUNT per trade (e.g. $100)
RISK_MODE=percentage
RISK_PERCENT_PER_TRADE=1.0
RISK_FIXED_AMOUNT=100.0

# Risk limits (apply regardless of mode)
MAX_OPEN_TRADES=5
MAX_DAILY_LOSS_PERCENT=5.0
MAX_EXPOSURE_PER_SYMBOL=2
MIN_RR_RATIO=1.5
MAX_LOT_SIZE=10.0
MIN_LOT_SIZE=0.01

# Execution
TP1_PARTIAL_CLOSE_PERCENT=50
MOVE_SL_TO_BE_ON_TP1=true

# Position manager
POSITION_POLL_INTERVAL_SEC=5.0

# Infrastructure
# WAIRNING/ DEBUG/ ERROR/ INFO
LOG_LEVEL=DEBUG 
STORAGE_PATH=./data

# ── Live trading protections ──────────────────────────────────────────────────
# [1] Max slippage accepted AFTER a fill (pips). If exceeded, position is
#     immediately closed. Set higher for volatile pairs (XAU/USD, BTC: 5-10).
MAX_ENTRY_SLIPPAGE_PIPS=3.0

# [2] Spread surcharge for lot sizing.
#     1.0 = full spread added to SL distance (recommended for live/standard accounts)
#     0.0 = disabled (demo or tight ECN accounts)
SPREAD_RISK_MULTIPLIER=1.0

# [3] Retry count on requote/rejection (0 = no retries)
ORDER_RETRY_COUNT=2
ORDER_RETRY_DELAY_SEC=0.5